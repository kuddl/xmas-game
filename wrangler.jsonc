{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xmas-game",
  "compatibility_date": "2025-07-15",
  // Worker for /api/* (online leaderboard, ticket 024); static files come from dist/
  "main": "worker/index.js",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "christmas.familiesailer.com",
      "custom_domain": true
    }
  ]
}
